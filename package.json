{
    "name": "chrome-subscribe-save-oneclick-cancel",
    "version": "1.0.0",
    "description": "chrome-subscribe-save-oneclick-cancel",
    "license": "MIT",
    "author": "Long Zheng",
    "repository": {
        "type": "git",
        "url": "https://github.com/longzheng/chrome-subscribe-save-oneclick-cancel.git"
    },
    "type": "module",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite",
        "build": "pnpm run clean && vite build",
        "clean": "rimraf dist chrome-subscribe-save-oneclick-cancel.zip",
        "test": "vitest run --passWithNoTests",
        "lint": "oxlint .",
        "build-zip": "pnpm run build && cd dist && zip -r ../chrome-subscribe-save-oneclick-cancel.zip *",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "raygun4js": "^3.1.4"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@tsconfig/strictest": "^2.0.8",
        "@types/chrome": "0.2.2",
        "@types/raygun4js": "^3.0.0",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
    },
    "packageManager": "pnpm@11.22.0"
}
